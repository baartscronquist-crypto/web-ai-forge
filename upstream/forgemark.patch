@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import { applyFormulaSuggestion, formulaCommentFields, formulaSpans, resolveFormulaAnchor } from "../../../src/format/formulaAnchors";
+import { parseForgemarkFile } from "../../../src/format/parser";
+import { serializeForgemarkFile } from "../../../src/format/serializer";
+import type { Comment } from "../../../src/format/types";
+import { listComments, suggestFormula } from "../../../cli/lib";
+
+const now = "2026-11-08T01:00:00Z";
+
+function commentAt(body: string, index: number, from: number, to: number): Comment {
+  return {
+    id: 1, author: "Reviewer", timestamp: now, resolved: false, body: "Please check this term.",
+    ...formulaCommentFields(body, formulaSpans(body)[index], from, to),
+  };
+}
+
+describe("formula anchors", () => {
+  it("maps display, inline and fenced equations while ignoring literal code", () => {
+    const body = ["A formula $x^2$ and \x60$not_math$\x60.", "", "$$", "f(x)=x^2", "$$", "", "\x60\x60\x60math", "a+b", "\x60\x60\x60", ""].join("\n");
+    expect(formulaSpans(body).map(({ tex, kind, texStart, texEnd }) =>
+      [kind, tex, body.slice(texStart, texEnd)],
+    )).toEqual([
+      ["inline", "x^2", "x^2"],
+      ["display", "f(x)=x^2", "f(x)=x^2"],
+      ["display", "a+b", "a+b"],
+    ]);
+  });
+
+  it("preserves Markdown and uses the exact selected LaTeX source after round-trip", () => {
+    const body = "First $x_i + x_j$.\r\n\r\n$$\r\nT_i=x_i\r\n+ x_j\r\n$$\r\n\r\n";
+    const c = commentAt(body, 1, 8, 13);
+    const saved = parseForgemarkFile(serializeForgemarkFile({ body, comments: [c] }));
+    // The shared YAML serializer adds a separator before the comments block.
+    expect(saved.body).toBe(body + "\n");
+    expect(saved.comments[0].anchor_text).toBe("+ x_j");
+    const location = resolveFormulaAnchor(saved.body, saved.comments[0]);
+    expect(location).toMatchObject({ tex: "+ x_j", line: 5, column: 1 });
+    expect(listComments(saved, "markdown")[0]).toMatchObject({
+      status: "attached", current: "+ x_j", formulaLocation: { line: 5, column: 1 },
+    });
+  });
+
+  it("anchors the correct duplicate and refuses newly ambiguous copies", () => {
+    const body = "One: $x$. Two: $x$. Three: $x$.";
+    const c = commentAt(body, 1, 0, 1);
+    expect(resolveFormulaAnchor(body, c)?.from).toBe(body.indexOf("$x$", 10) + 1);
+    expect(resolveFormulaAnchor("New: $x$. Next: $x$.", c)).toBeNull();
+    expect(resolveFormulaAnchor("One: $x$.", c)).toBeNull();
+  });
+
+  it("creates a pending proposal and only applies exact matching TeX", () => {
+    const body = "A formula $x^2 + y$.\n";
+    const c = commentAt(body, 0, 0, 3);
+    const result = suggestFormula({ body, comments: [c] }, 1, {
+      author: "Codex", replacement: "x^3", now,
+    });
+    expect(result.file.body).toBe(body);
+    const suggestion = result.file.comments[1];
+    expect(suggestion).toMatchObject({
+      review_parent_id: 1, suggested_edit: { from: "x^2", to: "x^3" }, resolved: false,
+    });
+    expect(applyFormulaSuggestion(body, suggestion)).toBe("A formula $x^3 + y$.\n");
+    expect(applyFormulaSuggestion(body.replace("y", "z"), suggestion)).toBeNull();
+    expect(() => suggestFormula({ body, comments: [c] }, 1, {
+      author: "Codex", replacement: "x$ y", now,
+    })).toThrow(/preserves/);
+  });
+});
diff --git a/tests/unit/versionHistory.test.ts b/tests/unit/versionHistory.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/versionHistory.test.ts
@@ -0,0 +1,151 @@
+import { expect, it } from "vitest";
+import { fakeTauri } from "../utils/harness";
+import {
+  readVersionHistory,
+  revertVersionChange,
+  saveVersionedDocument,
+  versionApprovals,
+  versionBody,
+  versionHistoryPath,
+  versionIsCommitted,
+  type SavedVersion,
+} from "../../src/services/versionHistory";
+import { insertMarkersIntoBody, parseForgemarkFile, serializeForgemarkFile, type Comment } from "../../src/format";
+import { INITIAL_STATE, reduceDocument } from "../../src/state/document";
+import { formulaCommentFields, formulaSpans, resolveFormulaAnchor, retargetFormulaRequest } from "../../src/format/formulaAnchors";
+
+const path = "/versions/draft.md";
+const at = "2026-11-08T00:00:00Z";
+const before = "# Methods\n\nPore pressure supplies the electrical input.\n\n";
+const after = before.replace("supplies", "provides");
+const version: SavedVersion = { id: "1", at, before, after };
+
+it("records the exact before and after bytes, then restores a saved version through the same path", async () => {
+  fakeTauri.seed(path, before);
+  await saveVersionedDocument(path, after, "markdown", before);
+  expect(await fakeTauri.fs.readTextFile(path)).toBe(after);
+  expect(await readVersionHistory(path)).toEqual([expect.objectContaining({ before, after })]);
+  await saveVersionedDocument(path, before, "markdown", after);
+  expect(await fakeTauri.fs.readTextFile(path)).toBe(before);
+  expect(await readVersionHistory(path)).toEqual([
+    expect.objectContaining({ before: after, after: before }),
+    expect.objectContaining({ before, after }),
+  ]);
+});
+
+it("refuses a stale save without overwriting the file or creating a history record", async () => {
+  fakeTauri.seed(path, "# Newer external edit\n");
+  await expect(saveVersionedDocument(path, after, "markdown", before)).rejects.toThrow("changed on disk");
+  expect(await fakeTauri.fs.readTextFile(path)).toBe("# Newer external edit\n");
+  expect(await fakeTauri.fs.exists(versionHistoryPath(path))).toBe(false);
+});
+
+it("refuses to overwrite a malformed version journal", async () => {
+  fakeTauri.seed(path, before);
+  fakeTauri.seed(versionHistoryPath(path), "Unexpected data");
+  await expect(saveVersionedDocument(path, after, "markdown", before)).rejects.toThrow();
+  expect(await fakeTauri.fs.readTextFile(path)).toBe(before);
+  expect(await fakeTauri.fs.readTextFile(versionHistoryPath(path))).toBe("Unexpected data");
+});
+
+it("retains a before-image without presenting a failed save as a committed version", async () => {
+  fakeTauri.seed(path, before);
+  const rename = fakeTauri.fs.rename.getMockImplementation()!;
+  fakeTauri.fs.rename.mockImplementation((from, to) =>
+    to === path ? Promise.reject(new Error("Document write refused")) : rename(from, to),
+  );
+  await expect(saveVersionedDocument(path, after, "markdown", before)).rejects.toThrow("write refused");
+  expect(await fakeTauri.fs.readTextFile(path)).toBe(before);
+  const records = await readVersionHistory(path);
+  expect(records[0]).toMatchObject({ state: "staged", before, after });
+  expect(versionIsCommitted(records[0], before, records)).toBe(false);
+});
+
+it("reverts only the changed source, preserving newer content and nearby review anchors", () => {
+  const start = after.indexOf("Pore pressure");
+  const comment: Comment = { id: 1, author: "Reviewer", timestamp: at, anchor_text: "Pore pressure", resolved: false, body: "Keep the mechanism." };
+  const body = insertMarkersIntoBody(after, start, start + comment.anchor_text!.length, 1);
+  const current = serializeForgemarkFile({ body: body + "Later edit.\n", comments: [comment] });
+  const restored = revertVersionChange(current, version, "markdown");
+  expect(versionBody(restored, "markdown")).toBe(before + "Later edit.");
+  expect(parseForgemarkFile(restored).comments).toEqual([comment]);
+});
+
+it("refuses restoration when the passage changed or its context occurs twice", () => {
+  expect(() => revertVersionChange(after.replace("provides", "feeds"), version, "markdown")).toThrow("no longer matches");
+  expect(() => revertVersionChange(after + after, version, "markdown")).toThrow("no longer matches");
+});
+
+it("derives a per-approval undo even when several approved changes share one save", () => {
+  const heading = "Alpha supplies input.";
+  const footer = "Beta supplies input.";
+  const middle = "\n\n" + "Stable explanatory text. ".repeat(5) + "\n\n";
+  const startBody = heading + middle + footer;
+  const comments: Comment[] = [heading, footer].map((value, index) => ({
+    id: index + 1,
+    author: "Codex",
+    timestamp: at,
+    resolved: false,
+    anchor_text: value,
+    suggested_edit: { from: value, to: value.replace("supplies", "provides") },
+  }));
+  let withMarkers = startBody;
+  for (const c of comments.slice().reverse()) {
+    const start = withMarkers.indexOf(c.anchor_text!);
+    withMarkers = insertMarkersIntoBody(withMarkers, start, start + c.anchor_text!.length, c.id);
+  }
+  const approvals = comments.map((c) => ({
+    ...c, resolved: true, floating: true, review_status: "accepted" as const, reviewed_at: at, reviewed_by: "Reviewer",
+  }));
+  const saved = {
+    id: "two-approvals",
+    at,
+    before: serializeForgemarkFile({ body: withMarkers, comments }),
+    after: serializeForgemarkFile({ body: startBody.replaceAll("supplies", "provides"), comments: approvals }),
+  };
+  const decisions = versionApprovals(saved, "markdown");
+  expect(decisions.map((d) => d.commentId)).toEqual([1, 2]);
+  const restored = revertVersionChange(saved.after, decisions[0], "markdown");
+  expect(versionBody(restored, "markdown")).toBe(heading + middle + footer.replace("supplies", "provides"));
+  expect(parseForgemarkFile(restored).comments).toEqual(approvals);
+});
+
+it("derives and reverses an approved formula change without moving the historical record", () => {
+  const math = "# Example\n\nUse $x^2$ in this test.\n";
+  const request: Comment = {
+    id: 1, author: "Reviewer", timestamp: at, resolved: false, body: "Please review the exponent.",
+    ...formulaCommentFields(math, formulaSpans(math)[0], 0, 3),
+  };
+  const proposal: Comment = {
+    id: 2, author: "Codex", timestamp: at, resolved: false, review_parent_id: 1,
+    ...formulaCommentFields(math, formulaSpans(math)[0], 0, 3),
+    suggested_edit: { from: "x^2", to: "x^3" },
+  };
+  const approval: Comment = {
+    ...proposal, resolved: true, review_status: "accepted", reviewed_at: at, reviewed_by: "Reviewer",
+  };
+  const changed = math.replace("x^2", "x^3");
+  const saved = {
+    id: "formula",
+    at,
+    before: serializeForgemarkFile({ body: math, comments: [request, proposal] }),
+    after: serializeForgemarkFile({ body: changed, comments: [retargetFormulaRequest(math, changed, proposal, request), approval] }),
+  };
+  const [decision] = versionApprovals(saved, "markdown");
+  expect(decision.commentId).toBe(2);
+  const restored = revertVersionChange(saved.after, decision, "markdown");
+  expect(versionBody(restored, "markdown")).toBe(math.trimEnd());
+  const parsed = parseForgemarkFile(restored);
+  expect(parsed.comments[0]).toMatchObject({ id: request.id, body: request.body, anchor_text: "x^2" });
+  expect(resolveFormulaAnchor(parsed.body, parsed.comments[0])?.tex).toBe("x^2");
+  expect(parsed.comments[1]).toEqual(approval);
+});
+
+it("only stages a version restore against the unchanged clean tab", () => {
+  const clean = { ...INITIAL_STATE, filePath: path, originalText: after, body: after };
+  const action = { type: "restoreVersion" as const, text: before, expected: after };
+  const dirty = { ...clean, dirty: true };
+  expect(reduceDocument(dirty, action)).toBe(dirty);
+  expect(reduceDocument(clean, { ...action, expected: "Older view" })).toBe(clean);
+  expect(reduceDocument(clean, action)).toMatchObject({ sourceDraft: before, dirty: true, viewMode: "source" });
+});
