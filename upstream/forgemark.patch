new file mode 100644
--- /dev/null
+++ b/src/format/formulaAnchors.ts
@@ -0,0 +1,187 @@
+import MarkdownIt from "markdown-it";
+import { splitFrontmatter } from "./frontmatter";
+import { markdownExtras } from "./markdownExtras";
+import type { Comment, FormulaAnchor } from "./types";
+
+export type FormulaSpan = {
+  kind: "inline" | "display";
+  tex: string;
+  start: number;
+  end: number;
+  texStart: number;
+  texEnd: number;
+};
+
+const markdown = new MarkdownIt({ html: true });
+markdownExtras(markdown);
+const normalizeNewlines = (value: string) => value.replace(/\r\n?/g, "\n");
+
+// Map the parser's LF-normalised coordinates back to the original file.
+function sourceOffsets(body: string): number[] {
+  const offsets = [0];
+  for (let i = 0; i < body.length; i++) {
+    if (body[i] === "\r" && body[i + 1] === "\n") i++;
+    offsets.push(i + 1);
+  }
+  return offsets;
+}
+
+// Use the Markdown parser that creates the rendered equations; a dollar in a
+// code fence, an escaped dollar or a literal price is not a formula anchor.
+// Refuse a range unless its original source can be mapped unambiguously.
+export function formulaSpans(body: string): FormulaSpan[] {
+  const front = splitFrontmatter(body).front.length;
+  const original = body.slice(front);
+  const source = normalizeNewlines(original);
+  const offsets = sourceOffsets(original);
+  const lines = [0];
+  for (let i = 0; i < source.length; i++) if (source[i] === "\n") lines.push(i + 1);
+  const absolute = (pos: number) => front + offsets[pos];
+  const out: FormulaSpan[] = [];
+  let row: [number, number] | null = null;
+  for (const token of markdown.parse(source, {})) {
+    if (token.type === "tr_open") row = token.map ?? null;
+    if (token.type === "tr_close") row = null;
+    const map = token.map ?? row;
+    if (!map) continue;
+    const blockStart = lines[map[0]];
+    const blockEnd = lines[map[1]] ?? source.length;
+    const block = source.slice(blockStart, blockEnd);
+    if (token.type === "inline") {
+      const first = block.indexOf(token.content);
+      if (first < 0 || block.indexOf(token.content, first + 1) >= 0) continue;
+      for (const child of token.children ?? []) {
+        if (child.type !== "fm_math_inline") continue;
+        const start = blockStart + first + child.meta.mathSourceStart;
+        const end = blockStart + first + child.meta.mathSourceEnd;
+        if (source.slice(start, end) !== "$" + child.content + "$") continue;
+        out.push({
+          kind: "inline", tex: child.content, start: absolute(start), end: absolute(end),
+          texStart: absolute(start + 1), texEnd: absolute(end - 1),
+        });
+      }
+      continue;
+    }
+    const mathFence = token.type === "fence" && token.info.trim() === "math";
+    if (token.type !== "fm_math_block" && !mathFence) continue;
+    const value = block.replace(/\n$/, "");
+    const tex = mathFence ? token.content.replace(/\n$/, "") : token.content;
+    const oneLine = !mathFence && !value.includes("\n");
+    const firstLine = value.split("\n", 1)[0];
+    const first = oneLine ? value.indexOf("$$") + 2 : firstLine.length + 1;
+    const last = oneLine ? value.lastIndexOf("$$") : value.lastIndexOf("\n");
+    const raw = value.slice(first, last);
+    const trim = oneLine ? raw.length - raw.trimStart().length : 0;
+    if ((oneLine ? raw.trim() : raw) !== tex || !tex) continue;
+    out.push({
+      kind: "display", tex, start: absolute(blockStart), end: absolute(blockStart + value.length),
+      texStart: absolute(blockStart + first + trim), texEnd: absolute(blockStart + first + trim + tex.length),
+    });
+  }
+  return out;
+}
+
+const context = (body: string, start: number, end: number) => ({
+  before: body.slice(Math.max(0, start - 64), start),
+  after: body.slice(end, end + 64),
+});
+
+export function formulaCommentFields(
+  body: string,
+  span: FormulaSpan,
+  from: number,
+  to: number,
+): Pick<Comment, "floating" | "anchor_text" | "formula_anchor"> {
+  if (from < 0 || to > span.tex.length || from >= to || !span.tex.slice(from, to).trim()) {
+    throw new Error("Select a nonempty LaTeX expression.");
+  }
+  const anchor: FormulaAnchor = {
+    kind: span.kind,
+    source: body.slice(span.start, span.end),
+    from,
+    to,
+    ...context(body, span.start, span.end),
+    unique: formulaSpans(body).filter((match) =>
+      match.kind === span.kind && body.slice(match.start, match.end) === body.slice(span.start, span.end),
+    ).length === 1,
+  };
+  return {
+    // A release without formula anchors can still read the comment.
+    floating: true,
+    anchor_text: span.tex.slice(from, to),
+    formula_anchor: anchor,
+  };
+}
+
+export function formulaAnchor(comment: Comment): FormulaAnchor | null {
+  return comment.formula_anchor ?? null;
+}
+
+export function resolveFormulaAnchor(body: string, comment: Comment, spans = formulaSpans(body)) {
+  const anchor = formulaAnchor(comment);
+  if (!anchor) return null;
+  const candidates = spans.filter((span) =>
+    span.kind === anchor.kind && body.slice(span.start, span.end) === anchor.source &&
+    anchor.to <= span.tex.length &&
+    span.tex.slice(anchor.from, anchor.to) === comment.anchor_text,
+  );
+  const sides = candidates.filter((span) => {
+    const around = context(body, span.start, span.end);
+    return around.before === anchor.before && around.after === anchor.after;
+  });
+  let span = sides.length === 1 ? sides[0] : null;
+  if (!span && anchor.unique && candidates.length === 1) {
+    const candidate = candidates[0];
+    const around = context(body, candidate.start, candidate.end);
+    if ((anchor.before && around.before.endsWith(anchor.before)) ||
+        (anchor.after && around.after.startsWith(anchor.after))) span = candidate;
+  }
+  if (!span) return null;
+  const tex = body.slice(span.texStart, span.texEnd);
+  const offsets = sourceOffsets(tex);
+  const from = span.texStart + offsets[anchor.from];
+  const to = span.texStart + offsets[anchor.to];
+  const line = body.slice(0, from).split("\n").length;
+  const column = from - body.lastIndexOf("\n", from - 1);
+  return { span, from, to, line, column, tex: body.slice(from, to) };
+}
+
+// The proposed replacement may change the selected TeX, but it must keep
+// the same formula delimiters and must still parse as exactly one equation.
+export function applyFormulaSuggestion(body: string, comment: Comment): string | null {
+  const selection = resolveFormulaAnchor(body, comment);
+  const suggestion = comment.suggested_edit;
+  if (!selection || !suggestion || selection.tex !== suggestion.from) return null;
+  const { from, to, span } = selection;
+  if (/<!--|\u0000/.test(suggestion.to)) return null;
+  const proposed = body.slice(0, from) + suggestion.to + body.slice(to);
+  const newEnd = span.end + suggestion.to.length - (to - from);
+  const tex = normalizeNewlines(
+    body.slice(span.texStart, from) + suggestion.to + body.slice(to, span.texEnd),
+  );
+  const stillFormula = formulaSpans(proposed).some((next) =>
+    next.kind === span.kind && next.start === span.start && next.end === newEnd && next.tex === tex,
+  );
+  return stillFormula ? proposed : null;
+}
+
+// Keep the request thread attached after its own proposal is accepted.
+// The archived proposal retains the original expression in suggested_edit.
+export function retargetFormulaRequest(
+  before: string,
+  after: string,
+  proposal: Comment,
+  request: Comment,
+): Comment {
+  const anchor = formulaAnchor(proposal);
+  const original = resolveFormulaAnchor(before, proposal);
+  if (!anchor || !original || !proposal.suggested_edit || !formulaAnchor(request) ||
+      request.id !== proposal.review_parent_id) return request;
+  const replacement = normalizeNewlines(proposal.suggested_edit.to);
+  const span = formulaSpans(after).find((next) => next.start === original.span.start && next.kind === anchor.kind);
+  if (!span) return request;
+  const from = replacement.trim() ? anchor.from : 0;
+  const to = replacement.trim() ? from + replacement.length : span.tex.length;
+  if (span.tex.slice(from, to) !== (replacement.trim() ? replacement : span.tex)) return request;
+  return { ...request, ...formulaCommentFields(after, span, from, to) };
+}
