+import { exists, lstat, readTextFile, remove, rename, writeTextFile } from "@tauri-apps/plugin-fs";
+import { findMarkers, pairMarkers, parseForgemarkFile, replaceAnchoredText, serializeForgemarkFile, type DocFormat } from "../format";
+import { applyFormulaSuggestion, formulaAnchor, formulaCommentFields, formulaSpans, resolveFormulaAnchor } from "../format/formulaAnchors";
+import { saveDocument } from "./fileIO";
+
+export type SavedVersion = { id: string; at: string; before: string; after: string; state?: "staged" | "saved" };
+export type ApprovalVersion = SavedVersion & { commentId: number };
+
+const MAX_RECORDS = 20;
+const MAX_HISTORY_CHARACTERS = 8_000_000;
+const writes = new Map<string, Promise<void>>();
+
+export function versionHistoryPath(path: string): string {
+  return `${path}.forgemark-versions.json`;
+}
+
+export async function readVersionHistory(path: string): Promise<SavedVersion[]> {
+  const sidecar = versionHistoryPath(path);
+  if (!(await exists(sidecar))) return [];
+  const info = await lstat(sidecar);
+  if (!info.isFile || info.isSymlink) throw new Error("Version history must be a regular file.");
+  const data = JSON.parse(await readTextFile(sidecar));
+  if (data?.schema !== 1 || !Array.isArray(data.versions) || data.versions.some((item: SavedVersion) =>
+    !item || [item.id, item.at, item.before, item.after].some(value => typeof value !== "string") ||
+    (item.state !== undefined && item.state !== "staged" && item.state !== "saved") ||
+    !Number.isFinite(Date.parse(item.at)))) {
+    throw new Error("Version history has an unsupported format.");
+  }
+  return data.versions;
+}
+
+async function writeVersionHistory(path: string, versions: SavedVersion[]): Promise<void> {
+  const sidecar = versionHistoryPath(path);
+  const temp = `${sidecar}.${crypto.randomUUID()}.forgemark-tmp`;
+  try {
+    await writeTextFile(temp, JSON.stringify({ schema: 1, versions }) + "\n");
+    await rename(temp, sidecar);
+  } catch (error) {
+    try { await remove(temp); } catch { /* keep the original write error */ }
+    throw error;
+  }
+}
+
+/** Save in place with a durable before-image, using the same atomic document writer. */
+export async function saveVersionedDocument(
+  path: string,
+  text: string,
+  format: DocFormat | undefined,
+  expected: string | undefined,
+  defaultName?: string,
+): Promise<void> {
+  const preceding = writes.get(path) ?? Promise.resolve();
+  const current = preceding.catch(() => {}).then(async () => {
+    const before = (await exists(path)) ? await readTextFile(path) : undefined;
+    if (expected !== undefined && before !== undefined && before !== expected) {
+      throw new Error("The file changed on disk. Reload it before saving this version.");
+    }
+    let staged: SavedVersion[] | undefined;
+    if (before !== undefined && before !== text) {
+      const previous = await readVersionHistory(path);
+      const latest = previous[0];
+      if (latest?.before !== before || latest.after !== text) {
+        let size = before.length + text.length;
+        const kept = previous.slice(0, MAX_RECORDS - 1).filter((version) => {
+          size += version.before.length + version.after.length;
+          return size <= MAX_HISTORY_CHARACTERS;
+        });
+        const record: SavedVersion = { id: crypto.randomUUID(), at: new Date().toISOString(), before, after: text, state: "staged" };
+        // Keep the newest before-image even for an unusually large document.
+        staged = [record, ...kept];
+        await writeVersionHistory(path, staged);
+      } else if (latest.state === "staged") {
+        staged = previous;
+      }
+      // The journal write above may take time. Recheck before touching the document.
+      if (await readTextFile(path) !== before) {
+        throw new Error("The file changed during backup. Reload it before saving.");
+      }
+    }
+    if (before !== text || format !== undefined) {
+      if (format === undefined) await saveDocument(path, text);
+      else await saveDocument(path, text, format, defaultName);
+      if (staged) {
+        const [record, ...older] = staged;
+        try {
+          await writeVersionHistory(path, [{ ...record, state: "saved" }, ...older]);
+        } catch (error) {
+          // The document is already saved and its prior bytes are on disk.
+          // A later read can verify the staged transition against the file.
+          console.warn("[forgemark] Could not mark version as committed", error);
+        }
+      }
+    }
+  });
+  writes.set(path, current);
+  try { await current; }
+  finally { if (writes.get(path) === current) writes.delete(path); }
+}
+
+export function versionIsCommitted(version: SavedVersion, current: string, versions: SavedVersion[]): boolean {
+  return version.state !== "staged" || version.after === current ||
+    versions.some((later) => later.at >= version.at && later.id !== version.id && later.before === version.after);
+}
+
+function withoutMarkers(body: string, format: DocFormat) {
+  const markers = findMarkers(body, format);
+  let clean = "";
+  let previous = 0;
+  for (const marker of markers) {
+    clean += body.slice(previous, marker.start);
+    previous = marker.end;
+  }
+  clean += body.slice(previous);
+  return { clean, markers };
+}
+
+export function versionBody(text: string, format: DocFormat): string {
+  try {
+    return withoutMarkers(parseForgemarkFile(text, { tolerant: true, format }).body, format).clean.trimEnd();
+  } catch {
+    return text.trimEnd();
+  }
+}
+
+/** Recover individual approvals even when a single save recorded several. */
+export function versionApprovals(version: SavedVersion, format: DocFormat): ApprovalVersion[] {
+  try {
+    const before = parseForgemarkFile(version.before, { format });
+    const after = parseForgemarkFile(version.after, { format });
+    const approvals: ApprovalVersion[] = [];
+    for (const decision of after.comments) {
+      const previous = before.comments.find((item) => item.id === decision.id);
+      if (decision.review_status !== "accepted" || !decision.suggested_edit || !previous?.suggested_edit || previous.review_status) continue;
+      if (decision.suggested_edit.from !== previous.suggested_edit.from ||
+          decision.suggested_edit.to !== previous.suggested_edit.to) continue;
+      let body: string;
+      if (formulaAnchor(previous)) {
+        const replacement = applyFormulaSuggestion(before.body, previous);
+        if (replacement === null) continue;
+        body = replacement;
+      } else {
+        const replacement = replaceAnchoredText(before.body, decision.id, decision.suggested_edit.to, format);
+        if (!replacement || replacement.previousText !== previous.suggested_edit.from) continue;
+        body = replacement.body;
+      }
+      const isolated = serializeForgemarkFile({
+        body,
+        comments: before.comments.map((item) => item.id === decision.id ? decision : item),
+      });
+      approvals.push({
+        id: version.id + ":approval:" + decision.id,
+        at: decision.reviewed_at ?? version.at,
+        before: version.before,
+        after: isolated,
+        commentId: decision.id,
+      });
+    }
+    return approvals;
+  } catch {
+    return [];
+  }
+}
+
+export function versionDifference(before: string, after: string) {
+  let from = 0;
+  while (from < before.length && from < after.length && before[from] === after[from]) from++;
+  let beforeEnd = before.length;
+  let afterEnd = after.length;
+  while (beforeEnd > from && afterEnd > from && before[beforeEnd - 1] === after[afterEnd - 1]) {
+    beforeEnd--;
+    afterEnd--;
+  }
+  return { from, beforeEnd, afterEnd, removed: before.slice(from, beforeEnd), added: after.slice(from, afterEnd) };
+}
+
+/** Reverse one recorded body change only if its new text and context are still unique. */
+export function revertVersionChange(current: string, version: SavedVersion | ApprovalVersion, format: DocFormat): string {
+  const versionProse = (text: string) => withoutMarkers(parseForgemarkFile(text, { format }).body, format).clean.trimEnd();
+  const before = versionProse(version.before);
+  const after = versionProse(version.after);
+  const { from, afterEnd, added, removed } = versionDifference(before, after);
+  if (added === removed) throw new Error("This version contains review metadata changes only.");
+
+  const parsed = parseForgemarkFile(current, { format });
+  const { clean, markers } = withoutMarkers(parsed.body, format);
+  const left = after.slice(Math.max(0, from - 48), from);
+  const right = after.slice(afterEnd, afterEnd + 48);
+  const needle = left + added + right;
+  const position = needle ? clean.indexOf(needle) : -1;
+  if (position === -1 || clean.indexOf(needle, position + 1) !== -1) {
+    throw new Error("The saved passage no longer matches uniquely. The current file was preserved.");
+  }
+  function rawOffset(offset: number, afterMarker: boolean): number {
+    let hidden = 0;
+    for (const marker of markers) {
+      const visible = marker.start - hidden;
+      if (visible > offset || (visible === offset && !afterMarker)) break;
+      hidden += marker.end - marker.start;
+    }
+    return offset + hidden;
+  }
+  const start = rawOffset(position + left.length, true);
+  const end = added.length ? rawOffset(position + left.length + added.length, false) : start;
+  if (pairMarkers(markers).pairs.some(pair => start < pair.close.end && end > pair.open.start)) {
+    throw new Error("This change intersects a current comment anchor. The current file was preserved.");
+  }
+  const body = parsed.body.slice(0, start) + removed + parsed.body.slice(end);
+  let comments = parsed.comments;
+  if ("commentId" in version && format === "markdown") {
+    const original = parseForgemarkFile(version.before, { format });
+    const proposal = original.comments.find(c => c.id === version.commentId);
+    const originalRequest = original.comments.find(c => c.id === proposal?.review_parent_id);
+    const originalAnchor = originalRequest && formulaAnchor(originalRequest);
+    const request = comments.find(c => c.id === originalRequest?.id);
+    const now = request && resolveFormulaAnchor(parsed.body, request);
+    if (request && originalAnchor && now && start >= now.span.texStart && end <= now.span.texEnd) {
+      const restored = formulaSpans(body).find(span =>
+        span.start === now.span.start && body.slice(span.start, span.end) === originalAnchor.source,
+      );
+      if (restored) comments = comments.map(c => c.id === request.id
+        ? { ...c, ...formulaCommentFields(body, restored, originalAnchor.from, originalAnchor.to) }
+        : c);
+    }
+  }
+  return serializeForgemarkFile({ body, comments });
+}
