diff --git a/src/components/VersionHistoryDialog.tsx b/src/components/VersionHistoryDialog.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/VersionHistoryDialog.tsx
@@ -0,0 +1,146 @@
+import { useEffect, useMemo, useState } from "react";
+import type { DocumentState } from "../state/document";
+import {
+  readVersionHistory,
+  revertVersionChange,
+  versionBody,
+  versionApprovals,
+  versionIsCommitted,
+  versionDifference,
+  type SavedVersion,
+} from "../services/versionHistory";
+import { Modal } from "./Modal";
+import "./VersionHistoryDialog.css";
+
+type Props = {
+  state: DocumentState;
+  onRestore: (text: string, expected: string) => void;
+  onClose: () => void;
+};
+
+type RestoreMode = "change" | "file";
+
+export function VersionHistoryDialog({ state, onRestore, onClose }: Props) {
+  const [versions, setVersions] = useState<SavedVersion[] | null>(null);
+  const [selected, setSelected] = useState("");
+  const [comparison, setComparison] = useState<"change" | "current">("change");
+  const [confirm, setConfirm] = useState<RestoreMode | null>(null);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    if (!state.filePath) return;
+    let active = true;
+    void readVersionHistory(state.filePath)
+      .then((items) => {
+        if (!active) return;
+        setVersions(items);
+        setSelected(items[0]?.id ?? "");
+      })
+      .catch((err: unknown) => {
+        if (active) setError(err instanceof Error ? err.message : String(err));
+      });
+    return () => { active = false; };
+  }, [state.filePath]);
+
+  const approvals = useMemo(
+    () => versions?.flatMap((item) => versionIsCommitted(item, state.originalText, versions) ? versionApprovals(item, state.format) : []) ?? [],
+    [versions, state.format, state.originalText],
+  );
+  const approval = approvals.find((item) => item.id === selected);
+  const version = approval ?? versions?.find((item) => item.id === selected);
+  const committed = version && versionIsCommitted(version, state.originalText, versions ?? []);
+  const before = version ? versionBody(version.before, state.format) : "";
+  const after = version ? versionBody(version.after, state.format) : "";
+  const current = version ? versionBody(state.originalText, state.format) : "";
+  const comparing = comparison === "change" && committed ? "change" : "current";
+  const target = comparing === "change" ? after : current;
+  const diff = versionDifference(before, target);
+  const left = before.slice(Math.max(0, diff.from - 80), diff.from);
+  const right = before.slice(diff.beforeEnd, diff.beforeEnd + 80);
+  const canRestore = !!version && !state.dirty && !state.readOnly && !state.externalChange;
+
+  function restore() {
+    if (!version || !confirm || !canRestore) return;
+    try {
+      const text = confirm === "file"
+        ? version.before
+        : revertVersionChange(state.originalText, version, state.format);
+      onRestore(text, state.originalText);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : String(err));
+      setConfirm(null);
+    }
+  }
+
+  return (
+    <Modal labelledBy="fm-versions-title" testId="fm-versions-dialog" onClose={onClose} width={760}>
+      <header className="fm-modal-header">
+        <h2 id="fm-versions-title" className="fm-modal-title">Version history</h2>
+      </header>
+      <section className="fm-modal-body fm-version-body">
+        {error && <p role="alert">{error}</p>}
+        {!versions && !error && <p>Loading local versions…</p>}
+        {versions?.length === 0 && <p>A backup appears after saving a change to this file.</p>}
+        {version && (
+          <>
+            <div className="fm-version-selectors">
+              <label>
+                Snapshot
+                <select value={selected} onChange={(event) => { setSelected(event.target.value); setConfirm(null); setError(""); }}>
+                  <optgroup label="Saved versions">
+                    {versions!.map((item) => (
+                      <option key={item.id} value={item.id}>{new Date(item.at).toLocaleString()}{versionIsCommitted(item, state.originalText, versions!) ? "" : " · Backup before an unconfirmed save"}</option>
+                    ))}
+                  </optgroup>
+                  {approvals.length > 0 && (
+                    <optgroup label="Individual approvals">
+                      {approvals.map((item) => (
+                        <option key={item.id} value={item.id}>Suggestion #{item.commentId} · {new Date(item.at).toLocaleString()}</option>
+                      ))}
+                    </optgroup>
+                  )}
+                </select>
+              </label>
+              <label>
+                Compare with
+                <select value={comparing} onChange={(event) => setComparison(event.target.value === "current" ? "current" : "change")}>
+                  <option value="change" disabled={!committed}>The next content in this save</option>
+                  <option value="current">Current file</option>
+                </select>
+              </label>
+            </div>
+            {diff.removed || diff.added ? (
+              <div className="fm-version-diff" data-testid="fm-version-diff">
+                <div><h3>Before</h3><pre>{left}<del>{diff.removed || "∅"}</del>{right}</pre></div>
+                <div><h3>{comparing === "change" ? "After" : "Current"}</h3><pre>{left}<ins>{diff.added || "∅"}</ins>{target.slice(diff.afterEnd, diff.afterEnd + 80)}</pre></div>
+              </div>
+            ) : <p>The Markdown body is identical. The saved review records may differ.</p>}
+            {!canRestore && <p>Save or resolve the current file before restoring a version.</p>}
+            {confirm && (
+              <p role="status">
+                {confirm === "file"
+                  ? "Restore the entire snapshot, including its review records? The current file will be backed up first."
+                  : "Reverse this saved body change? The current review records will be retained."}
+              </p>
+            )}
+          </>
+        )}
+      </section>
+      <footer className="fm-modal-footer">
+        <button type="button" className="fm-btn" onClick={onClose}>Close</button>
+        <div className="fm-modal-spacer" />
+        {confirm ? (
+          <>
+            <button type="button" className="fm-btn" onClick={() => setConfirm(null)}>Cancel restore</button>
+            <button type="button" className="fm-btn fm-btn-primary" disabled={!canRestore} onClick={restore}>Confirm restore</button>
+          </>
+        ) : (
+          <>
+            <button type="button" className="fm-btn" disabled={!canRestore || !committed || before === after} onClick={() => { setComparison("change"); setConfirm("change"); }}>Revert this change</button>
+            <button type="button" className="fm-btn" disabled={!canRestore || !!approval || version?.before === state.originalText} onClick={() => { setComparison("current"); setConfirm("file"); }}>Restore entire snapshot</button>
+          </>
+        )}
+      </footer>
+    </Modal>
+  );
+}
