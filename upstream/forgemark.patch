+import { fireEvent, screen, waitFor } from "@testing-library/react";
+import { expect, it } from "vitest";
+import { renderApp } from "../utils/harness";
+import { useDocument } from "../../src/state/DocumentProvider";
+import { formulaCommentFields, formulaSpans, resolveFormulaAnchor } from "../../src/format/formulaAnchors";
+import { suggestFormula } from "../../cli/lib";
+
+const body = "An inline formula $x_i+x_j$.\n\n$$\nT=x_i+x_j\n$$\n";
+
+function Probe() {
+  const { state } = useDocument();
+  const comment = state.comments[0];
+  const range = comment && resolveFormulaAnchor(state.body, comment);
+  return <output data-testid="formula-probe">{range ? [range.tex, range.line, range.column].join("|") : ""}</output>;
+}
+
+it("opens a clickable formula's exact source, annotates a subexpression and leaves TeX intact", async () => {
+  renderApp({ load: { body }, probe: <Probe /> });
+  await waitFor(() => expect(document.querySelector(".fm-math-block")).not.toBeNull());
+  fireEvent.click(document.querySelector(".fm-math-block .katex")!);
+  const dialog = await screen.findByTestId("fm-formula-comment");
+  const tex = screen.getByLabelText("LaTeX source") as HTMLTextAreaElement;
+  expect(tex.value).toBe("T=x_i+x_j");
+  tex.focus();
+  tex.setSelectionRange(6, 9);
+  fireEvent.select(tex);
+  fireEvent.change(screen.getByLabelText("Comment"), { target: { value: "Check the second term." } });
+  fireEvent.click(screen.getByRole("button", { name: "Save comment" }));
+  expect(dialog.isConnected).toBe(false);
+  expect(screen.getByTestId("formula-probe").textContent).toBe("x_j|4|7");
+  expect(document.querySelector(".fm-math-block")?.getAttribute("data-fm-math-block")).toBe("T=x_i+x_j");
+});
+
+it("keeps the request attached and archives the selected replacement after human approval", async () => {
+  const now = "2026-11-08T01:00:00Z";
+  const file = suggestFormula({
+    body,
+    comments: [{
+      id: 1, author: "Reviewer", timestamp: now, resolved: false, body: "Check the exponent.",
+      ...formulaCommentFields(body, formulaSpans(body)[0], 0, 3),
+    }],
+  }, 1, { author: "Codex", replacement: "x_k", now }).file;
+  renderApp({ load: file, probe: <Probe /> });
+  fireEvent.click(await screen.findByTestId("fm-card-2"));
+  fireEvent.click(await screen.findByTestId("fm-card-accept-2"));
+  expect(screen.getByTestId("fm-card-2")).toHaveAttribute("data-review-status", "accepted");
+  expect(screen.getByTestId("formula-probe").textContent).toBe("x_k|1|20");
+  expect(document.querySelector(".fm-math")?.getAttribute("data-fm-math")).toBe("x_k+x_j");
+  expect(document.querySelector(".fm-math-block")?.getAttribute("data-fm-math-block")).toBe("T=x_i+x_j");
+});
