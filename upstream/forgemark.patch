new file mode 100644
--- /dev/null
+++ b/src/components/FormulaCommentDialog.tsx
@@ -0,0 +1,60 @@
+import { useState } from "react";
+import { Modal } from "./Modal";
+import type { FormulaSpan } from "../format/formulaAnchors";
+import "./FormulaCommentDialog.css";
+
+export function FormulaCommentDialog({
+  formula,
+  onSubmit,
+  onClose,
+}: {
+  formula: FormulaSpan;
+  onSubmit: (from: number, to: number, comment: string) => void;
+  onClose: () => void;
+}) {
+  const [selection, setSelection] = useState<[number, number] | null>(null);
+  const [comment, setComment] = useState("");
+  const [from, to] = selection ?? [0, formula.tex.length];
+  const selectionText = formula.tex.slice(from, to);
+  const readSelection = ({ currentTarget }: { currentTarget: HTMLTextAreaElement }) => {
+    const { selectionStart, selectionEnd } = currentTarget;
+    setSelection(selectionEnd > selectionStart ? [selectionStart, selectionEnd] : null);
+  };
+  return (
+    <Modal labelledBy="fm-formula-comment-title" testId="fm-formula-comment" onClose={onClose}>
+      <form
+        className="fm-formula-comment"
+        onSubmit={(event) => {
+          event.preventDefault();
+          if (comment.trim() && selectionText.trim()) onSubmit(from, to, comment.trim());
+        }}
+      >
+        <h2 id="fm-formula-comment-title">Comment on formula</h2>
+        <p>Select part of the LaTeX below to comment on it. With no selection, the comment covers the whole formula.</p>
+        <label>
+          LaTeX source
+          <textarea
+            readOnly
+            rows={Math.min(12, Math.max(3, formula.tex.split("\n").length + 1))}
+            value={formula.tex}
+            onSelect={readSelection}
+            onPointerUp={readSelection}
+            onKeyUp={readSelection}
+          />
+        </label>
+        <p className="fm-formula-target" aria-live="polite">
+          {selection ? <><strong>Selected:</strong> <code>{selectionText}</code></> : "Whole formula selected"}
+        </p>
+        {selection && <button type="button" onClick={() => setSelection(null)}>Use whole formula</button>}
+        <label>
+          Comment
+          <textarea rows={4} value={comment} onChange={(event) => setComment(event.target.value)} />
+        </label>
+        <footer>
+          <button type="button" onClick={onClose}>Cancel</button>
+          <button type="submit" disabled={!comment.trim() || !selectionText.trim()}>Save comment</button>
+        </footer>
+      </form>
+    </Modal>
+  );
+}
